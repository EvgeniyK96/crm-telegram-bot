# Token from @BotFather
BOT_TOKEN=
# CRM REST API (the bot only reads from it)
CRM_API_URL=https://crm-example-j3lm.vercel.app/api
CRM_USERNAME=
CRM_PASSWORD=
# Web UI for "Open in CRM" buttons (defaults to CRM_API_URL without /api)
# CRM_WEB_URL=
BOT_LANG=en
# Comma-separated Telegram user ids; empty = anyone can use the bot
ALLOWED_USER_IDS=
POLL_SECONDS=60
DIGEST_TIME=09:00
TZ_NAME=Asia/Almaty
DB_PATH=/data/bot.sqlite3
